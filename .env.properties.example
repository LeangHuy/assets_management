# MariaDB
DB_URL=jdbc:mariadb://localhost:3308/assets_db

# Backend (must match MYSQL_USER / MYSQL_PASSWORD unless you use root)
APP_PORT=8082
DB_USERNAME=root
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005,http://127.0.0.1:3000

# Ed25519 public key from license-key-format (required for license activate/status)
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_STORAGE_PATH=data/license/active.lic
